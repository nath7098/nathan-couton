    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^9.39.1",
    "playwright": "^1.63.0",
    "postcss-custom-media": "^12.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
