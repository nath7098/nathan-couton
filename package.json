{
  "name": "nathan-couton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/security-headers.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run build && npm run test:api && npm run smoke && npm run lighthouse && node scripts/check-budgets.mjs",
    "icons": "node scripts/build-sprite.mjs",
    "assets:fetch": "node --experimental-strip-types scripts/fetch-remote-assets.mjs",
    "test:api": "node scripts/test-api.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "happy-dom": "^20.14.5",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "postcss-custom-media": "^12.0.1",
    "simple-icons": "^16.32.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vue-i18n": "^11.4.12",
    "@intlify/core-base": "^11.4.12",
    "@intlify/message-compiler": "^11.4.12",
    "@intlify/shared": "^11.4.12"
  }
}
