# Public site origin, used for canonical URLs and OpenGraph tags.
NUXT_PUBLIC_SITE_URL=https://nathancouton.fr

# Server-only — consumed by POST /api/contact. Set these in Vercel's project
# settings; they are never exposed to the browser.
NUXT_EMAILJS_SERVICE_ID=
NUXT_EMAILJS_TEMPLATE_ID=
NUXT_EMAILJS_PUBLIC_KEY=
# Optional but recommended: makes the call server-only, so a leaked public key
# cannot be used to post through the template.
NUXT_EMAILJS_PRIVATE_KEY=
